# Skopiuj na serwer jako /opt/intermanage-beta/.env (chmod 600). Opis: deploy/README.md, sekcja „Beta”.

# Osobna baza bety w LXC Postgresa (nigdy intermanage_prod: beta migruje schemat przed produkcją)
DB_URL=jdbc:postgresql://192.168.33.110:5432/intermanage_beta
DB_USERNAME=intermanage_beta
DB_PASSWORD=
# openssl rand -base64 48, inny niż na produkcji
JWT_SECRET=
# openssl rand -base64 32. Inny niż na produkcji = hasła KSeF, klucze MEA i kopii z kopii produkcji są w becie
# nieczytelne (bezpieczniej). Ten sam co na produkcji = działają, ale wtedy beta zużywa limity KSeF produkcji.
APP_SECRET_KEY=

OWNER_USERNAME=admin
OWNER_PASSWORD=

# Puste = maile tylko w logach (baza bety bywa kopią produkcji z prawdziwymi adresami)
MAIL_HOST=

# Opcjonalnie, jak na produkcji
GEMINI_API_KEY=
GUS_API_KEY=

# Token tunelu intermanage-beta z Cloudflare Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=
