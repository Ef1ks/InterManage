# Skopiuj na serwer jako /opt/intermanage/.env (chmod 600). Wartości wygeneruj raz i nie zmieniaj.

# PostgreSQL w osobnym LXC
DB_URL=jdbc:postgresql://192.168.33.110:5432/intermanage_prod
DB_USERNAME=intermanage_prod
DB_PASSWORD=
# openssl rand -base64 48  (min. 32 znaki; zmiana wylogowuje wszystkich)
JWT_SECRET=
# openssl rand -base64 32  (32 bajty; zmiana unieważnia zapisane hasła do kluczy KSeF)
APP_SECRET_KEY=

OWNER_USERNAME=admin
# Puste = losowe hasło w logach backendu przy pierwszym starcie (docker compose logs backend)
OWNER_PASSWORD=

# Maile: Brevo → SMTP & API → SMTP (login to adres typu xxx@smtp-brevo.com, hasło to wygenerowany klucz SMTP).
# Puste MAIL_HOST = maile tylko w logach backendu.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Adres w domenie zweryfikowanej w Brevo (Senders, Domains & Dedicated IPs).
MAIL_FROM_ADDRESS=noreply@intermanage.pl
MAIL_FROM_NAME=Intermanage
# Tu trafią odpowiedzi odbiorców (puste = do nadawcy).
MAIL_REPLY_TO=

# Klucz Gemini (Google AI Studio → API keys, projekt w płatnym planie) do propozycji AI we Wprowadzaniu danych.
# Puste = propozycje nowych artykułów tylko z kartoteki sklepu, bez modelu.
GEMINI_API_KEY=

# Dane firmy po NIP-ie z GUS („Pobierz z GUS” przy dostawcy, sklepie i danych pracodawcy). Klucz produkcyjny BIR
# z GUS (regon_bir@stat.gov.pl). Puste = funkcja niedostępna.
GUS_API_URL=https://wyszukiwarkaregon.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc
GUS_API_KEY=

# Zdjęcia profilowe i tła kont w Cloudflare R2. Token: Cloudflare → R2 Object Storage → Manage API tokens
# (Object Read & Write, tylko ten bucket). R2_S3_API = adres S3 z nazwą bucketu na końcu, R2_PUBLIC_URL = domena
# podpięta do bucketu (Settings → Custom Domains). Puste = zdjęcia zostają w bazie.
R2_S3_API=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=cdn.intermanage.pl

# Kopia zapasowa bazy na Dysk Google (Ustawienia → Kopia zapasowa). Klient OAuth z Google Cloud Console, instrukcja
# w deploy/README.md (sekcja 4a). Puste = połączenie z Google niedostępne.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token tunelu z Cloudflare Zero Trust → Networks → Tunnels → (tunel) → Install connector
TUNNEL_TOKEN=
