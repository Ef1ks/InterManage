# Skopiuj na serwer jako /opt/intermanage/.env (chmod 600). Wartości wygeneruj raz i nie zmieniaj.

# PostgreSQL w osobnym LXC
DB_URL=jdbc:postgresql://192.168.33.110:5432/intermanage_prod
DB_USERNAME=intermanage_prod
DB_PASSWORD=
# openssl rand -base64 48  (min. 32 znaki; zmiana wylogowuje wszystkich)
JWT_SECRET=
# openssl rand -base64 32  (32 bajty; zmiana unieważnia zapisane hasła do kluczy KSeF)
APP_SECRET_KEY=

OWNER_USERNAME=admin
# Puste = losowe hasło w logach backendu przy pierwszym starcie (docker compose logs backend)
OWNER_PASSWORD=

# Maile: Brevo → SMTP & API → SMTP (login to adres typu xxx@smtp-brevo.com, hasło to wygenerowany klucz SMTP).
# Puste MAIL_HOST = maile tylko w logach backendu.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Adres w domenie zweryfikowanej w Brevo (Senders, Domains & Dedicated IPs).
MAIL_FROM_ADDRESS=noreply@intermanage.pl
MAIL_FROM_NAME=Intermanage
# Tu trafią odpowiedzi odbiorców (puste = do nadawcy).
MAIL_REPLY_TO=

# Token tunelu z Cloudflare Zero Trust → Networks → Tunnels → (tunel) → Install connector
TUNNEL_TOKEN=
