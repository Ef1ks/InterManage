{
  "expo": {
    "name": "Intermanage Kiosk",
    "slug": "intermanage-kiosk",
    "scheme": "intermanage-kiosk",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "pl.intermanage.kiosk",
      "adaptiveIcon": {
        "backgroundColor": "#E6E5E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.NFC"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "react-native-nfc-manager",
        {
          "includeNdefEntitlement": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://intermanage.pl",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8233ae16-74c9-4fa1-9549-957091cc9ab5"
      }
    }
  }
}
